{
  "name": "printdrop",
  "private": true,
  "version": "1.0.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:virtual": "powershell -ExecutionPolicy Bypass -File ./scripts/build-installers.ps1 -Edition Virtual",
    "build:retail": "powershell -ExecutionPolicy Bypass -File ./scripts/build-installers.ps1 -Edition Retail",
    "build:all": "powershell -ExecutionPolicy Bypass -File ./scripts/build-installers.ps1 -Edition All",
    "release": "powershell -ExecutionPolicy Bypass -File ./scripts/release.ps1",
    "admin:serve": "node ./scripts/serve-admin-portal.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
