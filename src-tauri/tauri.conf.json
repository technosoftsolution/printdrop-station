{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrintDrop Demo Station",
  "version": "1.0.22",
  "identifier": "com.printdrop.demo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PrintDrop Demo Station - Shopkeeper Counter OS",
        "width": 1280,
        "height": 700,
        "minWidth": 780,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "bin/SumatraPDF.exe",
      "bin/SumatraPDF-settings.txt",
      "bin/cloudflared.exe"
    ],
    "shortDescription": "PrintDrop Retail Print Shop Counter OS (Demo Edition)",
    "longDescription": "PrintDrop Retail Print Shop Counter OS - Automated Mobile File Drops, UPI Billing, Spooling Hub & Intelligent Multi-Printer Routing",
    "copyright": "Copyright © 2026 TechnoSoft Solution",
    "category": "Productivity"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyNzQ0RTI3NTc4MkE2MDEKUldRQnBvSlhKMDUwOGhLb1VvNFRsMUhGYTJJWkJkSVAwR1B2akVCdXlSbmZlVEc3SzYwM1VrT3YK",
      "endpoints": [
        "https://nslcrlvuulgqtrdqrkgv.supabase.co/functions/v1/ota-update?edition=retail"
      ]
    }
  }
}
